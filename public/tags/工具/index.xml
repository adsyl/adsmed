      <title>测试工具</title>
      <link>http://localhost:1313/blog/099%E6%B5%8B%E8%AF%95%E5%B7%A5%E5%85%B7/</link>
      <pubDate>Wed, 06 May 2026 13:47:08 +0200</pubDate>
      <guid>http://localhost:1313/blog/099%E6%B5%8B%E8%AF%95%E5%B7%A5%E5%85%B7/</guid>
      <description>&lt;script src=&#34;http://localhost:1313/js/chart.min.min.363d1ac7bb4ec8e79b4958f0dcf6ccbffcd98005204f0b07a1691ab06e288650.js&#34; integrity=&#34;sha256-Nj0ax7tOyOebSVjw3PbMv/zZgAUgTwsHoWkasG4ohlA=&#34;&gt;&lt;/script&gt;&#xD;&#xA;&lt;script src=&#34;http://localhost:1313/js/pgt-engine.min.be044c3a242e70d070c0f3af7e7c8879be6b15b8b4ce583bf032028cf73c4b99.js&#34; integrity=&#34;sha256-vgRMOiQucNBwwPOvfnyIeb5rFbi0zlg78DICjPc8S5k=&#34;&gt;&lt;/script&gt;&#xD;&#xA;&#xD;&#xA;&lt;div class=&#34;flex-grow container mx-auto px-4 py-10 max-w-3xl&#34;&gt;&#xD;&#xA;        &lt;section class=&#34;glass-card rounded-[2.5rem] p-8 md:p-12 mb-10&#34;&gt;&#xD;&#xA;        &lt;form id=&#34;pgtForm&#34; style=&#34;display: grid; gap: 15px;&#34;&gt;&#xD;&#xA;            &lt;div style=&#34;display: grid; grid-template-columns: 1fr 1fr; gap: 10px;&#34;&gt;&#xD;&#xA;                &lt;input type=&#34;number&#34; id=&#34;age&#34; placeholder=&#34;年龄&#34; required style=&#34;border: 1px solid #ddd; padding: 10px; border-radius: 8px;&#34;&gt;&#xD;&#xA;                &lt;input type=&#34;number&#34; id=&#34;amh&#34; placeholder=&#34;AMH&#34; step=&#34;0.1&#34; required style=&#34;border: 1px solid #ddd; padding: 10px; border-radius: 8px;&#34;&gt;&#xD;&#xA;                &lt;input type=&#34;number&#34; id=&#34;afc&#34; placeholder=&#34;AFC&#34; required style=&#34;border: 1px solid #ddd; padding: 10px; border-radius: 8px;&#34;&gt;&#xD;&#xA;                &lt;input type=&#34;number&#34; id=&#34;fsh&#34; placeholder=&#34;FSH&#34; step=&#34;0.1&#34; required style=&#34;border: 1px solid #ddd; padding: 10px; border-radius: 8px;&#34;&gt;&#xD;&#xA;                &lt;input type=&#34;number&#34; id=&#34;lh&#34; placeholder=&#34;LH&#34; step=&#34;0.1&#34; required style=&#34;border: 1px solid #ddd; padding: 10px; border-radius: 8px;&#34;&gt;&#xD;&#xA;                &lt;input type=&#34;number&#34; id=&#34;e2&#34; placeholder=&#34;E2&#34; step=&#34;0.1&#34; required style=&#34;border: 1px solid #ddd; padding: 10px; border-radius: 8px;&#34;&gt;&#xD;&#xA;                &lt;input type=&#34;number&#34; id=&#34;heightCm&#34; placeholder=&#34;身高(cm)&#34; required style=&#34;border: 1px solid #ddd; padding: 10px; border-radius: 8px;&#34;&gt;&#xD;&#xA;                &lt;input type=&#34;number&#34; id=&#34;weightKg&#34; placeholder=&#34;体重(kg)&#34; step=&#34;0.1&#34; required style=&#34;border: 1px solid #ddd; padding: 10px; border-radius: 8px;&#34;&gt;&#xD;&#xA;            &lt;/div&gt;&#xD;&#xA;            &lt;select id=&#34;uterineCondition&#34; style=&#34;border: 1px solid #ddd; padding: 10px; border-radius: 8px;&#34;&gt;&#xD;&#xA;                &lt;option value=&#34;normal&#34;&gt;子宫正常&lt;/option&gt;&#xD;&#xA;                &lt;option value=&#34;adenomyosis_endo&#34;&gt;腺肌症/内异症&lt;/option&gt;&#xD;&#xA;            &lt;/select&gt;&#xD;&#xA;            &lt;div style=&#34;display: grid; grid-template-columns: 1fr 1fr; gap: 10px;&#34;&gt;&#xD;&#xA;                &lt;select id=&#34;liveBirthsCount&#34; style=&#34;border: 1px solid #ddd; padding: 10px; border-radius: 8px;&#34;&gt;&lt;option value=&#34;0&#34;&gt;0次活产&lt;/option&gt;&lt;option value=&#34;1&#34;&gt;1次活产&lt;/option&gt;&lt;/select&gt;&#xD;&#xA;                &lt;select id=&#34;miscarriageCount&#34; style=&#34;border: 1px solid #ddd; padding: 10px; border-radius: 8px;&#34;&gt;&lt;option value=&#34;0&#34;&gt;0次流产&lt;/option&gt;&lt;option value=&#34;1&#34;&gt;1次流产&lt;/option&gt;&lt;/select&gt;&#xD;&#xA;            &lt;/div&gt;&#xD;&#xA;            &lt;input type=&#34;hidden&#34; id=&#34;otherMedicalHistory&#34; value=&#34;none&#34;&gt;&#xD;&#xA;            &lt;button type=&#34;submit&#34; style=&#34;width: 100%; background: #fb7185; color: white; padding: 15px; border-radius: 12px; font-weight: bold; border: none; cursor: pointer; font-size: 16px;&#34;&gt;开始临床精算评估&lt;/button&gt;&#xD;&#xA;        &lt;/form&gt;&#xD;&#xA;    &lt;/section&gt;&#xD;&#xA;&#xD;&#xA;    &lt;div id=&#34;results&#34; style=&#34;display:none; margin-top: 30px; padding: 30px; background: #f9fafb; border-radius: 20px;&#34;&gt;&#xD;&#xA;        &lt;h2 style=&#34;color: #fb7185; font-size: 32px; font-weight: 900; margin-bottom: 10px;&#34; id=&#34;lbrDisplay&#34;&gt;--%&lt;/h2&gt;&#xD;&#xA;        &lt;p id=&#34;cycleDisplay&#34; style=&#34;color: #4b5563; font-weight: bold; margin-bottom: 20px;&#34;&gt;&lt;/p&gt;</description>
    </item>
